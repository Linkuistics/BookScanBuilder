direction: down
classes: {
  start: {style: {fill: "#17334b"; font-color: white; bold: true}}
}
open: Start here\nANY page or geometry group {class: start}
compare: Original / current\nFull page + native detail\nPair / group alignment views
choose: Choose adjustment {shape: diamond}
local: Page correction\nRotation / crop / split
book: Book placement\nSide / anchor / translation / canvas
preview: Draft preview\nShow affected pages and retained content
accept: Accept displayed change\nSave new geometry revision
discard: Discard or revert\nRecover retained baseline
unresolved: Retain unresolved\nRecord exact concern
final: Export screen\nEvery page remains in default order\nAcknowledge geometric limitations
open -> compare: "1. inspect"
compare -> choose: "2. choose"
choose -> local
choose -> book
local -> preview
book -> preview
preview -> accept: explicitly accept
preview -> discard: cancel / revert
choose -> unresolved: unsupported or uncertain
accept -> final: "3. save"
discard -> final
unresolved -> final
