direction: down
classes: {
  start: {style: {fill: "#17334b"; font-color: white; bold: true}}
}
source: Start here\nOne sole PDF {class: start}
import: Complete RGB pages\nFreeze a project snapshot
local: Page geometry\nRotation / crop / genuine spread review
book: Book geometry\nGroups / sides / anchors / matching
review: Review any page or group\nFull / native / paired views\nSave accepted revisions
export: Geometry PDF\nAccepted images, preserved order\nUnresolved local geometry explicit
external: Separate third-party passes\nReordering / removal / OCR {
  style: {fill: "#edf2f7"; stroke-dash: 4}
}
later: Later within-page correction\nOwn evidence and agreement required {
  style: {fill: "#fff5dd"; stroke-dash: 4}
}
source -> import: "1. read only"
import -> local: "2. assess every page"
local -> book: "3. accepted local geometry"
book -> review: "4. preview placement and margins"
review -> export: "5. accept or retain unresolved"
export -> external: ordinary PDF handoff
later -> local: new page-image revision
